DATABASE_URL="postgresql://ascollection:ascollection@localhost:5432/ascollection?schema=public"
ADMIN_EMAIL="admin@ascollection.pk"
ADMIN_PASSWORD="change-this-before-use"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Product uploads are stored in Cloudinary when all three credentials are set.
# Development falls back to public/uploads; production uploads are rejected without Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Safepay hosted card checkout. Use test-account credentials and sandbox mode first.
# Keep false to offer Cash on Delivery only. Set true only when ready to enable card payments.
CARD_PAYMENTS_ENABLED="false"
APP_URL="http://localhost:3000"
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
# Customer emails via Resend. Set only after verifying your sending domain.
RESEND_API_KEY=""
EMAIL_FROM="AS Collection <orders@your-verified-domain.com>"
# WhatsApp Business API comes later. Keep "log" so confirmation/feedback messages are recorded without sending.
WHATSAPP_PROVIDER="log"
# Hosting cron should call /api/jobs/notifications with this secret after deploy.
CRON_SECRET=""
